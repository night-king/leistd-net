{
  // 开发环境配置，随仓库提交，所有开发者共用。这里只放公开的本机开发值（开发 compose 的库口令、演示管理员口令）；
  // 真正的机密与只属于某台机器的覆盖一律放 user-secrets（开发环境自动加载、不进仓库）。
//#if (RemoteTokenAuth)
  "Authentication": {
    // 本机联调：签发方是本机 Identity 服务的前端开发服务器，与浏览器登录的地址、令牌里的 iss 一致
    "Issuer": "http://localhost:4200/"
  },
//#if (IncludeMultiTenancy)
  "Leistd": {
    // 回源 Identity 的机器身份：签发方同上；ClientId/ClientSecret 是凭据，放 user-secrets（见 README）
    "ServiceAuth": {
      "Authority": "http://localhost:4200/"
    },
    "ServiceClients": {
      "Identity": {
        // 租户连接向同一个本机 Identity 回源（前端开发服务器把 /api 代理到 Identity 后端）
        "BaseAddress": "http://localhost:4200/"
      }
    }
  },
//#endif
//#endif
//#if (LocalIdentity)
  "DefaultAdmin": {
    // 本机演示凭据，克隆后即可登录；它是公开的。只在库里还没有超级管理员时用于创建，
    // 用它建出的账号会一直保留这个口令直到被修改——连接共享的真实开发库前，先用 user-secrets 覆盖
    "Password": "Admin!Local2026"
  },
//#endif
//#if (OpenIddictServer)
  "OAuth": {
    // 开发证书只在本机使用：每台机器各生成一份，不能用于任何共享环境
    "UseDevelopmentCertificates": true,
    // 本机经前端开发服务器（http://localhost:4200）访问授权端点，没有 TLS
    "DisableHttpsRequirement": true
  },
//#endif
  "ConnectionStrings": {
    // 指向 deploy/docker-compose.dev.yml 起的本机库（只绑定 127.0.0.1，口令是公开的开发值），
    // 克隆后起依赖、跑一次迁移即可启动。DbMigrator 的开发配置与此一致；
    // 连接共享开发库时用 user-secrets 覆盖，不改这里
    "Default": "Host=localhost;Port=5432;Database=companyname-projectname;Username=postgres;Password=postgres"
  }
}
