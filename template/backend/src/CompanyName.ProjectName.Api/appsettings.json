{
//#if (RemoteTokenAuth)
  "Authentication": {
    // 必填：签发令牌的 Identity 服务地址（绝对 http(s) URI），缺失时启动失败
    "Issuer": "",
//#if (ResourceBrowserSession)
    // 必填：在 Identity 登记的 web/confidential 客户端；机密值由后端配置源提供
    "ClientId": "",
    "ClientSecret": "",
//#endif
    // 本服务 API 的资源标识：只接受受众是它的访问令牌。在 Identity 的 OAuth:ApiResources 里登记同一个值，
    // 后端依赖方申请的 API scope 映射到此受众；不同名时配置 Authentication:Scope
    "Audience": "companyname-projectname-api"
  },
//#endif
  "ConnectionStrings": {
    "Default": ""
  },
//#if (SpaFrontend)
  "SessionCookie": {
    // 会话时长（天）：会话 Cookie 的滑动过期与服务端会话的空闲时限
    "ExpireDays": 7
  },
//#endif
//#if (OpenIddictServer)
  "OAuth": {
    // 令牌签名与加密证书。默认必须显式提供（PKCS#12 文件路径 + 口令，口令属于凭据，由部署注入）；
    // 开发证书只在 appsettings.Development.json 里打开，缺证书且未打开时启动失败
    "UseDevelopmentCertificates": false,
    "DisableHttpsRequirement": false,
    // 访问令牌寿命：撤销与会话退出传到依赖方的最长时延。整秒且长于 1 分钟（浏览器会话的提前刷新窗口）
    "AccessTokenLifetime": "00:10:00",
    // 本服务 API 的资源标识，同名登记为 scope
    "Resource": "companyname-projectname-api",
    // 由本服务签发令牌的下游 API 的资源标识：每项登记为同名 scope，申请它签发的访问令牌受众即该值，
    // 下游服务把自己的 Authentication:Audience 设为同一个值
    "ApiResources": []
  },
//#endif
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
//#if (!IncludeOperationRecords)
        "Leistd.OperationRecords": "Information",
//#endif
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "//": "部署在 ingress/网关后面时填入代理网段或地址，否则转发头会被忽略（仅信任环回）",
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Cors": {
    // 默认为空：浏览器页面与 API 同源（本机开发经前端代理转发），不靠 CORS 放行。
    // 只为显式需要直接调用本 API 的其他源列出地址；它不参与浏览器认证，跨源部署前端不受支持
    "AllowedOrigins": []
  },
//#if (LocalIdentity)
  "DefaultAdmin": {
    // 库里还没有超级管理员时按此创建。Password 由部署注入（环境变量 / user-secrets），
    // 只在创建那一刻校验：缺失或不满足密码策略（至少 12 个字符）即启动失败；已有管理员时不需要。
    // 基础配置里刻意不放可用密码：开源模板里的默认密码等于公开凭据
    "Username": "admin",
    "Password": "",
    "Email": "admin@companyname-projectname.com",
    "DisplayName": "System Administrator"
  },
  "UserRegistration": {
    "Enabled": true,
//#if (Email)
    "EnableEmailVerification": false,
    "EmailCodeExpiryMinutes": 5,
    "EmailCodeSendIntervalSeconds": 60,
    "EmailCodeMaxAttempts": 5,
//#endif
    "CaptchaExpiryMinutes": 5
  },
//#endif
//#if (ExternalLogin)
  // 外部登录的部署基线：默认关闭，启用必须显式打开。ClientId/ClientSecret 属于凭据，不写在这里，
  // 由环境变量或 user-secrets 注入；宿主管理员也可在「系统设置 → 外部登录」里运行期覆盖，清除覆盖值即回到这里。
  // 开关打开但凭据不全时该提供方不可用，启动照常、只记警告。
  "ExternalAuth": {
    "Github": {
      "Enabled": false
    },
    "Google": {
      "Enabled": false
    }
  },
//#endif
  "Leistd": {
//#if (Email)
    "Security": {
      // Base64、至少32字节，所有实例和重启使用同一密钥。
      "VerificationCodes": { "Key": "" }
    },
//#endif
    // 分布式锁的键前缀默认是应用名（"companyname-projectname:"），登记在基础设施的缓存与锁注册里，API 与迁移、恢复作业共用。
    // 多个应用共用一个 Redis 时各自的前缀必须不同；需要追加环境时由部署侧设置 Leistd:Lock:Redis:KeyPrefix，
    // 并且 API 与所有迁移、恢复作业必须同值，否则锁键不同、彼此不互斥。前缀不会自动补分隔符。
//#if (IncludeOperationRecords)
    "OperationRecords": {
      // 操作记录到期归档。**默认关闭**：审计表只增不减是安全的默认值，
      // 一个默认就会动审计数据的开关，会让不知情的部署某天夜里悄悄丢掉合规所需的历史。
      // 启用后，早于保留期的记录会在每天 DailyRunHourUtc 点被**搬进 OperationRecordArchives 表**
      // （不是删除——数据仍在库里，只是不再参与日常查询）。
      // RetentionDays 取 30–3650；DailyRunHourUtc 按 UTC，要对齐当地凌晨需由部署侧自行换算。
      // Enabled 与 RetentionDays 是基线：宿主管理员可在系统设置的「审计」面板覆盖，下一轮归档即生效
      "Retention": {
        "Enabled": false,
        "RetentionDays": 365,
        "DailyRunHourUtc": 18,
        "BatchSize": 500
      }
    },
//#endif
//#if (IncludeNotifications)
    "Notifications": {
      // 旧通知的保留期清理，默认开启：已读保留 90 天、未读保留 365 天（未读不得短于已读）
      "Retention": {
        "Enabled": true,
        "ReadRetentionDays": 90,
        "UnreadRetentionDays": 365,
        "DailyRunHourUtc": 19,
        "BatchSize": 500
//#if (Email)
      },
      "Email": {
        // 站点对外地址：通知邮件把站内链接（如安全提醒指向的安全设置页）拼成可点开的绝对地址。
        // 留空则邮件不附站内链接；前端开启哈希路由（useHash）时以 /# 结尾，如 https://app.example.com/#
        "PublicBaseUrl": ""
      }
//#else
      }
//#endif
    },
//#endif
//#if (RemoteTokenAuth && IncludeMultiTenancy)
    "MultiTenancy": {
      // 租户路由缓存生存期（框架默认 10 分钟，写出来便于按环境调整）。改租户数据落点时的
      // 排空等待 = max(Access Token 有效期, 本值)，两者彼此独立；超过 1 小时拒绝启动
      "Routing": {
        "CacheLifetime": "00:10:00"
      }
    },
//#endif
    "Settings": {
      // 别的实例上改的宿主级设置（日志级别、发信参数、审计保留期）多久在本实例生效
      "Hosting": {
        "RefreshInterval": "00:00:30"
      }
    }
//#if (Email)
    ,
    // 发信配置。默认指向本机邮件捕获器（docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit），
    // 因此开发期能在 http://localhost:8025 看到真实投出去的信，而不是一封都没发。
    // 生产必须覆盖 Host/Port/EnableSsl/DefaultFromAddress；Username/Password 属于凭据，
    // 不写在这里，由环境变量或 user-secrets 注入。四项在启动期校验，配错则起不来。
    // 这里是部署基线：宿主管理员可在「系统设置 → 邮件发送」里运行期覆盖，清除覆盖值即回到这里。
    "Email": {
      "Smtp": {
        "Host": "localhost",
        "Port": 1025,
        "EnableSsl": false,
        "DefaultFromAddress": "noreply@companyname-projectname.local",
        "DefaultFromName": "CompanyName.ProjectName"
      }
    }
//#endif
//#if (RemoteTokenAuth && IncludeMultiTenancy)
    ,
    "ServiceClients": {
      "Identity": {
        // Resource 形态必填：回源租户连接配置的 Identity 服务地址，缺失时启动失败
        "BaseAddress": "",
        "Scope": "tenant-routing.read"
      }
    }
//#endif
  }
}
