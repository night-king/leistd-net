<Project>

  <!--
    生成项目后端的中央包管理（CPM）。
    src/*.csproj 仅写 version-less 的 PackageReference，版本在此统一声明。
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- 版本只在本文件声明：项目里写 Version 报 NU1008、引用未登记的包报 NU1010，VersionOverride 也禁掉（NU1013） -->
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>

  <!-- Leistd.* 框架包，版本统一取 Directory.Build.props 的 $(LeistdFrameworkVersion)；
       升级框架只改那一处。 -->
  <ItemGroup>
    <PackageVersion Include="Leistd.ExceptionHandling.Core" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.Data" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.ExceptionHandling.AspNetCore" Version="$(LeistdFrameworkVersion)" />
    <!--#if (IncludeLocalization)-->
    <PackageVersion Include="Leistd.Localization.AspNetCore" Version="$(LeistdFrameworkVersion)" />
    <!--#endif-->
    <PackageVersion Include="Leistd.DependencyInjection.DynamicProxy" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.Email.Core" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.Email.Smtp" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.Lock.Core" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.Lock.Memory" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.Lock.Redis" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.Security.Core" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.Security.OneTimeCodes" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.Security.AspNetCore" Version="$(LeistdFrameworkVersion)" />
    <!--#if (OpenIddictServer)-->
    <PackageVersion Include="Leistd.Security.OpenIddict.Server" Version="$(LeistdFrameworkVersion)" />
    <!--#endif-->
    <!--#if (RemoteTokenAuth)-->
    <PackageVersion Include="Leistd.Security.OpenIddict.Validation" Version="$(LeistdFrameworkVersion)" />
    <!--#endif-->
    <PackageVersion Include="Leistd.Authorization.Core" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.Authorization.AspNetCore" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.Authorization.EntityFrameworkCore" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.MultiTenancy.Core" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.MultiTenancy.AspNetCore" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.MultiTenancy.EntityFrameworkCore" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.MultiTenancy.Management" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.MultiTenancy.ServiceClient" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.UnitOfWork.Core" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.Auditing.Core" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.Auditing.EntityFrameworkCore" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.Settings.Core" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.Settings.EntityFrameworkCore" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.Settings.AspNetCore" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.Settings.Hosting" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.BackgroundJobs.Core" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.BackgroundJobs.InProcess" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.BackgroundJobs.EntityFrameworkCore" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.Notifications.Core" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.Notifications.EntityFrameworkCore" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.Notifications.AspNetCore.SignalR" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.Notifications.AspNetCore" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.Notifications.Settings" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.Notifications.Email" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.OperationRecords.Core" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.OperationRecords.EntityFrameworkCore" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.OperationRecords.AspNetCore" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.OperationRecords.Logging" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.RealTime.Core" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.RealTime.AspNetCore.SignalR" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.ObjectMapping.Mapster" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.Tracing.Core" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.Tracing.AspNetCore" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.Tracing.HttpClient" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.ServiceClient.Core" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.ServiceClient.OAuth" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.ServiceClient.AspNetCore" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.ServiceClient.Refit" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.Ddd.Domain" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.Ddd.Application" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.Ddd.Application.Contracts" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Leistd.Ddd.Infrastructure" Version="$(LeistdFrameworkVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
  </ItemGroup>

  <!-- 业务第三方包 -->
  <ItemGroup>
    <PackageVersion Include="System.Linq.Dynamic.Core" Version="1.7.4" />
    <PackageVersion Include="AspNet.Security.OAuth.GitHub" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <!-- 多副本与 Worker 的实时推送背板：配了 Redis 时由 Api 接上（Hosting/SignalRBackplaneExtensions） -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.13" />
    <!-- 设计时 DbContext 工厂（Infrastructure/Persistence/DesignTime）要自建 ConfigurationBuilder
         读取 appsettings 与环境变量。Api 是 Web SDK、由共享框架白送这三个包；Infrastructure 是
         普通类库，必须显式声明——与本项目"用到什么就声明什么、不吃共享框架传递依赖"的口径一致。 -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <!--#if (IncludeLocalization)-->
    <PackageVersion Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.13" />
    <!--#endif-->
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.13" />
    <!-- 单元测试在裸 ServiceCollection 上断言注册面，需要 AddLogging（应用层注册依赖 ILogger<>） -->
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.13" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Refit" Version="16.4.0" />
    <PackageVersion Include="OpenIddict.Abstractions" Version="7.7.2" />
    <PackageVersion Include="OpenIddict.AspNetCore" Version="7.7.2" />
    <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.7.2" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="StackExchange.Redis" Version="3.4.5" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

</Project>
