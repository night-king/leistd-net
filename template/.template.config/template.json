  "preferNameDirectory": true,
  "forms": {
    "LastSegment": {
      "identifier": "replace",
      "pattern": "^(.*\\.)?",
      "replacement": ""
    },
    "DotToHyphen": {
      "identifier": "replace",
      "pattern": "\\.",
      "replacement": "-"
    },
    "FullNameKebab": {
      "identifier": "chain",
      "steps": [
        "lowerCaseInvariant",
        "DotToHyphen"
      ]
    }
  },
  "symbols": {
    "ProjectName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "LastSegment",
      "replaces": "MyProject",
      "fileRename": "MyProject"
    },
    "KebabName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "FullNameKebab",
      "replaces": "companyname-projectname"
    },
    "ServiceRole": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "Identity",
      "description": "服务形态：Identity 自签发 OIDC 令牌并持有本地身份；Standalone 只用 Cookie 会话（内部系统，不带授权服务器）；Resource 校验远端令牌、不持有认证凭据（但持有本系统授权主体）。多租户时 Identity 与 Standalone 持有租户控制面",
      "choices": [
        {
          "choice": "Identity",
          "description": "身份中心：OIDC 签发 + 本地身份（多租户时含租户控制面）"
        },
        {
          "choice": "Standalone",
          "description": "一体化应用：Cookie 会话 + 本地身份（多租户时含租户控制面），不装 OpenIddict"
        },
        {
          "choice": "Resource",
          "description": "业务服务：校验远端令牌，不持有认证凭据；持有本系统的授权主体、角色与权限数据"
        }
      ]
    },
    "LocalIdentity": {
      "type": "computed",
      "value": "(ServiceRole != \"Resource\")"
    },
    "OpenIddictServer": {
      "type": "computed",
      "value": "(ServiceRole == \"Identity\")"
    },
    "RemoteTokenAuth": {
      "type": "computed",
      "value": "(ServiceRole == \"Resource\")"
    },
    "ExternalLogin": {
      "type": "computed",
      "value": "(LocalIdentity && IncludeExternalLogin)"
    },
    "SpaFrontend": {
      "type": "computed",
      "value": "(LocalIdentity || IncludeFrontend)"
    },
    "ResourceBrowserSession": {
      "type": "computed",
      "value": "(RemoteTokenAuth && IncludeFrontend)"
    },
    "Email": {
      "type": "computed",
      "value": "(LocalIdentity && IncludeEmail)"
    },
    "Impersonation": {
      "type": "computed",
      "value": "(LocalIdentity && IncludeMultiTenancy && IncludeOperationRecords)"
    },
    "IncludeFrontend": {
      "type": "parameter",
      "datatype": "bool",
      "description": "是否包含内置 Angular 前端与浏览器会话。仅 ServiceRole=Resource 有效：false 生成纯资源 API（只接受 Bearer）；Identity/Standalone 的交互登录就在前端里，始终包含，此开关无作用",
      "defaultValue": "true"
    },
    "IncludeMultiTenancy": {
      "type": "parameter",
      "datatype": "bool",
      "description": "是否包含多租户产品能力（租户解析、租户管理与控制库、按租户分库、租户选择与模拟登录）。false 生成只有宿主作用域的应用，并拒绝携带租户声明的身份",
      "defaultValue": "true"
    },
    "IncludeRealTime": {
      "type": "parameter",
      "datatype": "bool",
      "description": "是否包含业务实时能力（业务事件发布与资源订阅，SignalR Hub）。与通知相互独立；两者都开时共用一个 Hub 与一条前端连接",
      "defaultValue": "false"
    },
    "IncludeEmail": {
      "type": "parameter",
      "datatype": "bool",
      "description": "是否包含邮件发送（SMTP、邮箱验证、邮件设置与测试发信、通知邮件渠道）。仅 ServiceRole=Identity|Standalone 有效；Resource 不发邮件，此开关无作用",
      "defaultValue": "true"
    },
    "IncludeOperationRecords": {
      "type": "parameter",
      "datatype": "bool",
      "description": "是否包含内置操作记录历史（数据库存储、查询、导出、归档与界面）。false 时安全与关键操作仍经同一记录器写成结构化日志；模拟登录依赖可查询的历史，随之移除",
      "defaultValue": "true"
    },
    "IncludeNotifications": {
      "type": "parameter",
      "datatype": "bool",
      "description": "是否包含通知（发布、历史与未读数、通知中心、SignalR 推送与个人通知偏好）。不包含业务实时事件，后者见 IncludeRealTime",
      "defaultValue": "false"
    },
    "IncludeExternalLogin": {
      "type": "parameter",
      "datatype": "bool",
      "description": "是否包含外部登录（GitHub / Google 等第三方身份提供商）。仅在 ServiceRole=Identity|Standalone（有本地用户）下有效；Resource 形态下该开关无作用",
      "defaultValue": "false"
    },
    "IncludeLocalization": {
      "type": "parameter",
      "datatype": "bool",
      "description": "是否包含多语言（i18n）支持：前端 Transloco 运行时切换（有前端时）+ 后端按 culture 本地化（默认语言英语）",
      "defaultValue": "false"
    },
    "Ci": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "github",
      "description": "生成的 CI 流水线薄壳：只准备运行环境并调用 scripts/verify.ps1（完整回归入口，总是生成）",
      "choices": [
        {
          "choice": "github",
          "description": "GitHub Actions：.github/workflows/ci.yml"
        },
        {
          "choice": "gitlab",
          "description": "GitLab CI：.gitlab-ci.yml（Runner 须允许 Docker-in-Docker）"
        },
        {
          "choice": "none",
          "description": "不生成流水线文件"
        }
      ]
    }
  },
