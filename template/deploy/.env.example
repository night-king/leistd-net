# docker-compose.yml 需要的部署变量清单。复制为 deploy/.env（已被 Git 忽略）后逐项填写：
#   cp deploy/.env.example deploy/.env
# 这里只列变量名与用途，不放任何可用的值；真实值来自密钥管理系统或 CI 的 secret，不进仓库。
# 必填项在 compose 里以 ${VAR:?} 引用，漏填时 compose 会带着变量名直接失败。

# 数据库：迁移作业用 postgres（DDL）身份，backend 用只有 DML 权限的应用身份
MIGRATOR_DB_PASSWORD=
APP_DB_USER=
APP_DB_PASSWORD=
#if (LocalIdentity)

# 超级管理员口令（至少 12 个字符）：库里还没有超级管理员时用于创建，首次部署必填，已有管理员后可以不再提供
DEFAULT_ADMIN_PASSWORD=

# 可选：通行密钥的依赖方。PASSKEY_RP_ID 是站点的可注册域名（如 example.com），PASSKEY_ORIGIN 是页面来源
# （如 https://app.example.com，须落在 RP ID 之下）；都留空时通行密钥不可用。登记后不要再改 RP ID
PASSKEY_RP_ID=
PASSKEY_ORIGIN=
#endif
#if (Email)

# 发信（SMTP）：主机、端口与发件地址必填；账号与口令成对填写，服务器不要求认证时都留空
SMTP_HOST=
SMTP_PORT=
SMTP_FROM_ADDRESS=
SMTP_USERNAME=
SMTP_PASSWORD=
# 可选：是否用 TLS 连接 SMTP，缺省 true
# SMTP_ENABLE_SSL=true
# 可选：开启注册邮箱验证，缺省 false。开启时必须填验证码摘要密钥
# （Base64，至少 32 字节，如 openssl rand -base64 32 的输出；跨实例跨重启不变，缺失或无效即启动失败）
# ENABLE_EMAIL_VERIFICATION=true
VERIFICATION_CODES_KEY=
#endif
#if (ExternalLogin)

# 可选：外部登录。开关缺省 false，启用必须显式打开；打开后 ID 与密钥都填齐才生效，缺一项只记警告、不提供该入口。
# 也可以留空，由宿主管理员在「系统设置 → 外部登录」里配置（设置值覆盖这里）
# GITHUB_LOGIN_ENABLED=true
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GOOGLE_LOGIN_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#endif
#if (IncludeNotifications && Email)

# 可选：站点对外地址，通知邮件据此把站内链接拼成绝对地址（前端开启哈希路由时以 /# 结尾）
PUBLIC_BASE_URL=
#endif
#if (OpenIddictServer)

# 令牌签名与加密证书（PKCS#12 文件路径，相对 deploy/ 目录）及其口令
OAUTH_SIGNING_CERTIFICATE_FILE=
OAUTH_SIGNING_CERTIFICATE_PASSWORD=
OAUTH_ENCRYPTION_CERTIFICATE_FILE=
OAUTH_ENCRYPTION_CERTIFICATE_PASSWORD=
#endif
#if (RemoteTokenAuth)

# 身份服务：令牌签发方与回源地址。本服务的受众取 appsettings.json 的 Authentication:Audience，
# 并须在身份服务的 OAuth:ApiResources 里登记同一个值
IDENTITY_ISSUER=
#if (ResourceBrowserSession)
# 浏览器 OIDC 客户端（机密客户端，启用 Authorization Code + PKCE）
BROWSER_CLIENT_ID=
BROWSER_CLIENT_SECRET=
#endif
IDENTITY_AUTHORITY=
IDENTITY_BASE_ADDRESS=
# 身份服务自身 API 的标识（它的 OAuth:Resource）：代表用户写账户偏好时交换令牌的受众与 scope
IDENTITY_API_RESOURCE=
#if (IncludeMultiTenancy)
# 运行时与迁移作业使用不同的机器身份：运行时查路由与账户偏好，迁移只读迁移元数据
#else
# 运行时的机器身份：按用户读账户偏好
#endif
RESOURCE_CLIENT_ID=
RESOURCE_CLIENT_SECRET=
#if (IncludeMultiTenancy)
MIGRATOR_CLIENT_ID=
MIGRATOR_CLIENT_SECRET=
#endif
#endif

# 可选：镜像名。默认本地标签（companyname-projectname:latest、companyname-projectname-migrator:latest），
# 发布到镜像仓库时填完整名称，如 registry.example.com/team/companyname-projectname:1.0.0
# BACKEND_IMAGE=
# MIGRATOR_IMAGE=
# 可选：容器进程的本地时区，缺省 UTC
# TZ=UTC
