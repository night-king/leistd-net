<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!--
      使用关系型 Provider 而非 InMemory：OperationRecordConfiguration 的列长度、枚举字符串
      转换与倒序索引只有真正建库时才产生 DDL，InMemory 全内存求值会让配置整块静默通过。
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- 端点在真实 Minimal API 管线里验证：参数绑定与授权元数据只在那里成立 -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <!-- 失败路径"只记 Error 不抛"唯一可断言的对象是日志；用官方 FakeLogger -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <!-- 时间接缝用官方 FakeTimeProvider 驱动真实的 UtcClockProvider，不手写时间替身 -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <!-- 被拒记录的入口是 HttpContext 扩展，测它需要 ASP.NET Core 的类型 -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\components\operation-records\Leistd.OperationRecords.Core\Leistd.OperationRecords.Core.csproj" />
    <ProjectReference Include="..\..\..\..\components\operation-records\Leistd.OperationRecords.EntityFrameworkCore\Leistd.OperationRecords.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\..\..\components\operation-records\Leistd.OperationRecords.AspNetCore\Leistd.OperationRecords.AspNetCore.csproj" />
    <ProjectReference Include="..\..\..\..\components\operation-records\Leistd.OperationRecords.Logging\Leistd.OperationRecords.Logging.csproj" />
    <ProjectReference Include="..\..\..\..\components\exception-handling\Leistd.ExceptionHandling.AspNetCore\Leistd.ExceptionHandling.AspNetCore.csproj" />
    <ProjectReference Include="..\..\..\..\components\event-bus\Leistd.EventBus.Local\Leistd.EventBus.Local.csproj" />
    <!-- 自产失败码的随包译文经真实 JSON 本地化读出，不用替身 -->
    <ProjectReference Include="..\..\..\..\components\localization\Leistd.Localization.AspNetCore\Leistd.Localization.AspNetCore.csproj" />
    <ProjectReference Include="..\..\..\shared\Leistd.TestBase\Leistd.TestBase.csproj" />
  </ItemGroup>

</Project>
